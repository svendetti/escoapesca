    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.3",
    "next": "16.4.6",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.69.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "react-server-dom-webpack": "19.2.9",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.3.8",
    "vitest": "4.1.12",
    "wrangler": "4.162.0"
  },
  "overrides": {
